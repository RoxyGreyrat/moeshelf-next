{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoeShelf Next",
  "mainBinaryName": "MoeShelf Next",
  "version": "0.1.0",
  "identifier": "com.moeshelf.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MoeShelf Next",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
